+ if decision->>'decision' in ('DELETE','BLOCKED') and coalesce(decision->>'business_reason',decision->>'reason')
+  in ('REJECTED_BY_BUSINESS_PROCESS','CANCELLED_BY_BUSINESS_PROCESS') then
