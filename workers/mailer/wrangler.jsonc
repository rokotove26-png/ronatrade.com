// Temporary autonomous sender onboarding hook. Remove after Email Sending is enabled.
{
  "name": "rona-public-mailer",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "build": {
    "command": "timeout 90s npx --yes wrangler@latest email sending enable ronaoil.com || true"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": [
        "office_kg@ronaoil.com",
        "rokotove26@gmail.com"
      ],
      "allowed_sender_addresses": [
        "office_kg@ronaoil.com"
      ]
    }
  ]
}
